---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { landing, type Locale } from '../content/landing'
import { FALLBACK_DOWNLOAD_HREF, SOURCE_HREF, TWITTER_HREF } from '../lib/urls'
import '../styles/chrome.css'
import '@fontsource/oxanium/700.css'
import '@fontsource/figtree/400.css'
import '@fontsource/figtree/500.css'
import '@fontsource/ibm-plex-mono/400.css'

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const copy = landing[lang]
const enHref = getRelativeLocaleUrl('en')
const ptHref = getRelativeLocaleUrl('pt')
const keyboardHref = getRelativeLocaleUrl(lang, 'keyboard')
const canonical = new URL(Astro.url.pathname, Astro.site)
const enUrl = new URL(getRelativeLocaleUrl('en'), Astro.site)
const ptUrl = new URL(getRelativeLocaleUrl('pt'), Astro.site)
const screenshotSrc = `${import.meta.env.BASE_URL}app.webp`
const ogImage = new URL(`${import.meta.env.BASE_URL}og.jpg`, Astro.site)
const downloadCopyJson = JSON.stringify({
  actions: copy.downloadActions,
  warnings: copy.downloadWarnings
})
---

<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={copy.description} />
    <meta name="theme-color" content="#141414" />
    <meta property="og:title" content={copy.title} />
    <meta property="og:description" content={copy.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:alt" content={copy.screenshotAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@idlemanagerapp" />
    <meta name="twitter:title" content={copy.title} />
    <meta name="twitter:description" content={copy.description} />
    <meta name="twitter:image" content={ogImage.href} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="en" href={enUrl.href} />
    <link rel="alternate" hreflang="pt-BR" href={ptUrl.href} />
    <link rel="alternate" hreflang="x-default" href={enUrl.href} />
    <title>{copy.title}</title>
    <link rel="icon" href={`${import.meta.env.BASE_URL}icon.png`} type="image/png" />
  </head>
  <body>
    <a class="skip" href="#isolation">{copy.skip}</a>
    <header class="chrome">
      <p class="mark">
        <img src={`${import.meta.env.BASE_URL}icon.png`} width="32" height="32" alt="" />
        Idle manager
      </p>
      <nav class="page-nav" aria-label={copy.pageNav}>
        <a href="#isolation">{copy.isolation}</a>
        <a href="#how">{copy.how}</a>
        <a href="#not-a-bot">{copy.notBot}</a>
        <a href="#faq">{copy.faq}</a>
        <a href={keyboardHref}>{copy.keyboard}</a>
      </nav>
      <div class="chrome-end">
        <nav aria-label={copy.localeNav}>
          <a href={enHref} hreflang="en" lang="en" aria-current={lang === 'en' ? 'page' : undefined}
            >English</a
          >
          <a href={ptHref} hreflang="pt-BR" lang="pt-BR" aria-current={lang === 'pt' ? 'page' : undefined}
            >Português</a
          >
        </nav>
        <a class="download-action header-cta" data-platform-download href={FALLBACK_DOWNLOAD_HREF}
          >{copy.downloadAction}</a
        >
      </div>
    </header>
    <main>
      <section id="isolation" class="hero">
        <div class="hero-copy">
          <div>
            <p class="kicker">{copy.kicker}</p>
            <h1>{copy.headline}</h1>
            <p class="subhead">{copy.subhead}</p>
            <p class="claim">{copy.claim}</p>
          </div>
          <div class="hero-aside">
            <p class="hero-actions">
              <a class="download-action" data-platform-download href={FALLBACK_DOWNLOAD_HREF}
                >{copy.downloadAction}</a
              >
              <a class="text-link" href={SOURCE_HREF}>{copy.heroSecondary}</a>
            </p>
            <p class="smartscreen" data-download-warning>{copy.smartScreen}</p>
            <ul class="trust">
              {copy.trustItems.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </div>
        <figure class="shot">
          <img
            src={screenshotSrc}
            width="1920"
            height="1209"
            alt={copy.screenshotAlt}
            fetchpriority="high"
          />
          <figcaption>{copy.screenshotCaption}</figcaption>
        </figure>
      </section>

      <section id="problem" class="band">
        <p class="eyebrow">{copy.problemEyebrow}</p>
        <h2>{copy.problemHeadline}</h2>
        <p class="lead">{copy.problemLead}</p>
        <ul class="cards">
          {copy.problemItems.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))}
        </ul>
      </section>

      <section id="solution" class="band">
        <p class="eyebrow">{copy.solutionEyebrow}</p>
        <h2>{copy.solutionHeadline}</h2>
        <p class="lead">{copy.solutionLead}</p>
        <ul class="cards">
          {copy.features.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))}
        </ul>
      </section>

      <section id="how" class="band">
        <p class="eyebrow">{copy.howEyebrow}</p>
        <h2>{copy.howHeadline}</h2>
        <p class="lead">{copy.howLead}</p>
        <ol class="steps">
          {copy.steps.map((item, index) => (
            <li>
              <span class="step-index">{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))}
        </ol>
        <p class="inline-cta">
          <a class="download-action" data-platform-download href={FALLBACK_DOWNLOAD_HREF}
            >{copy.downloadAction}</a
          >
        </p>
      </section>

      <section id="not-a-bot" class="not-bot">
        <h2>{copy.notBot}</h2>
        <p class="lead">{copy.notBotLead}</p>
        <ul>
          {copy.notBotItems.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>

      <section id="faq" class="band faq">
        <p class="eyebrow">{copy.faqEyebrow}</p>
        <h2>{copy.faqHeadline}</h2>
        <div class="faq-list">
          {copy.faqs.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section id="download" class="download">
        <div>
          <h2>{copy.finalHeadline}</h2>
          <p class="lead">{copy.finalLead}</p>
        </div>
        <div class="download-cta">
          <p>
            <a class="download-action" id="download-link" data-platform-download href={FALLBACK_DOWNLOAD_HREF}
              >{copy.downloadAction}</a
            >
          </p>
          <p class="smartscreen" data-download-warning>{copy.smartScreen}</p>
        </div>
      </section>
    </main>
    <footer>
      <section id="privacy" class="legal">
        <h2>{copy.privacy}</h2>
        {copy.privacyParagraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </section>
      <section id="source" class="legal">
        <h2>{copy.source}</h2>
        <p>
          {copy.sourceLead}{' '}
          <a href={SOURCE_HREF}>{copy.sourceLink}</a>.
        </p>
        <p>
          <a href={TWITTER_HREF}>{copy.twitterLink}</a>
        </p>
      </section>
    </footer>
    <p class="sticky-cta">
      <a class="download-action" data-platform-download href={FALLBACK_DOWNLOAD_HREF}
        >{copy.downloadAction}</a
      >
    </p>
    <script id="download-copy" type="application/json" set:html={downloadCopyJson} />
    <script>
      import { probeDownloads, type DownloadCopy } from '../lib/probeWindowsDownload'

      const copyNode = document.getElementById('download-copy')
      const links = [...document.querySelectorAll('[data-platform-download]')].filter(
        (node): node is HTMLAnchorElement => node instanceof HTMLAnchorElement
      )
      const warnings = [...document.querySelectorAll('[data-download-warning]')].filter(
        (node): node is HTMLElement => node instanceof HTMLElement
      )
      if (copyNode?.textContent && links.length > 0) {
        const copy = JSON.parse(copyNode.textContent) as DownloadCopy
        void probeDownloads(links, warnings, copy)
      }
    </script>
  </body>
</html>

<style is:global>
  main,
  footer {
    width: min(var(--shell), 100%);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .chrome-end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
  }

  .header-cta {
    min-height: 48px;
  }

  footer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem 3rem;
    padding-top: 2.5rem;
    padding-bottom: 6rem;
    border-top: 1px solid var(--hairline);
    margin-top: 1rem;
  }

  h1,
  h2,
  h3 {
    font-family: Oxanium, Figtree, sans-serif;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  h1 {
    margin: 0 0 1rem;
    max-width: 14ch;
    font-size: clamp(2.4rem, 7vw, 4.4rem);
  }

  h2 {
    margin: 0 0 0.85rem;
    max-width: 22ch;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }

  h3 {
    margin: 0 0 0.45rem;
    font-size: 1.05rem;
    letter-spacing: 0;
    line-height: 1.25;
  }

  .hero {
    display: grid;
    gap: 2rem;
    padding: 3.5rem 0 2.5rem;
  }

  .hero-copy {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(16rem, 0.8fr);
    gap: 1.5rem 3rem;
    align-items: end;
  }

  .kicker {
    margin: 0 0 0.85rem;
    max-width: 42rem;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    color: var(--mute);
  }

  .subhead {
    max-width: 36rem;
    margin: 0 0 0.85rem;
    font-size: 1.2rem;
  }

  .claim {
    max-width: 42rem;
    margin: 0 0 1.5rem;
    color: var(--mute);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem 1.25rem;
    margin: 0 0 1rem;
  }

  .text-link {
    font-weight: 500;
    text-underline-offset: 0.28em;
  }

  .trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 1.35rem 0 0;
    list-style: none;
    max-width: 40rem;
  }

  .trust li {
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--seal);
    border-radius: 2px;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--mute);
  }

  .shot {
    margin: 0;
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--seal);
    background: var(--ink-lift);
  }

  .shot figcaption {
    margin: 0.75rem 0 0;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mute);
  }

  .band,
  .not-bot,
  .download,
  .legal {
    padding-top: 3rem;
  }

  .eyebrow {
    margin: 0 0 0.65rem;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mute);
  }

  .lead {
    max-width: 42rem;
    margin: 0 0 1.5rem;
  }

  .cards,
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .cards li,
  .steps li {
    padding: 1.15rem 1rem 1rem;
    background: var(--ink-lift);
    border: 1px solid var(--seal);
  }

  .cards p,
  .steps p {
    margin: 0;
    color: var(--mute);
    font-size: 1rem;
  }

  .step-index {
    display: block;
    margin-bottom: 0.7rem;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--signal);
  }

  .inline-cta {
    margin: 1.5rem 0 0;
  }

  .not-bot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: 3rem;
    row-gap: 0.75rem;
    align-items: start;
  }

  .not-bot ul {
    margin: 0;
    padding-left: 1.15rem;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.98rem;
    grid-column: 2;
    grid-row: 1 / span 3;
  }

  .not-bot li + li {
    margin-top: 0.45rem;
  }

  .faq {
    max-width: 42rem;
    margin-inline: auto;
  }

  .faq-list {
    display: grid;
    gap: 0.55rem;
  }

  details {
    background: var(--ink-lift);
    border: 1px solid var(--seal);
  }

  summary {
    cursor: pointer;
    padding: 0.95rem 1rem;
    font-weight: 500;
  }

  details p {
    margin: 0;
    padding: 0 1rem 1rem;
    color: var(--mute);
  }

  .legal {
    padding-top: 0;
  }

  .legal p {
    margin: 0 0 1rem;
  }

  .legal p:last-child {
    margin-bottom: 0;
  }

  .download {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.9fr);
    gap: 2rem 3rem;
    align-items: center;
    padding-bottom: 2.5rem;
  }

  .download .lead {
    margin-bottom: 0;
  }

  .download-cta .smartscreen {
    margin-top: 0.85rem;
  }

  .download-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.7rem 1.15rem;
    background: var(--signal);
    color: #fff;
    text-decoration: none;
    font-weight: 500;
    border-radius: 2px;
  }

  .download-action:focus-visible {
    outline: 2px solid var(--paper);
    outline-offset: 3px;
  }

  .smartscreen {
    margin: 1rem 0 0;
    max-width: 42rem;
    color: var(--mute);
    font-size: 1rem;
  }

  .sticky-cta {
    display: none;
  }

  @media (max-width: 840px) {
    .hero-copy,
    .cards,
    .steps,
    .not-bot,
    .download,
    footer {
      grid-template-columns: 1fr;
    }

    .not-bot ul {
      grid-column: 1;
      grid-row: auto;
    }

    .page-nav {
      display: none;
    }

    h1 {
      max-width: 12ch;
    }
  }

  @media (max-width: 720px) {
    .header-cta {
      display: none;
    }

    .download-action {
      width: 100%;
    }

    .hero-actions .text-link {
      width: 100%;
    }

    .sticky-cta {
      display: block;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 1;
      margin: 0;
      padding: 0.75rem 1.5rem calc(0.75rem + env(safe-area-inset-bottom));
      background: var(--ink);
      border-top: 1px solid var(--hairline);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
